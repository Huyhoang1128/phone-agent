# PostgreSQL
DB_NAME=mbcontrol
DB_USER=mbcontrol
DB_PASSWORD=mbcontrol

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,app.example.com,phone.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://app.example.com,https://app.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8030,http://app.example.com,https://app.example.com

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_DEVICE_EVENTS_TOPIC=device-events
KAFKA_COMMANDS_TOPIC=device-commands
KAFKA_DEVICES_WORKER_GROUP=devices-worker
KAFKA_TASK_STATUS_TOPIC=task_status

# WebRTC ICE servers
# Without a TURN server, WebRTC connections fail on 4G/5G because mobile
# carriers use Carrier-Grade NAT (CGNAT / symmetric NAT) which blocks direct
# peer-to-peer connections.  coturn is included as a Docker service; set the
# four TURN_* variables below, then point WEBRTC_ICE_SERVERS at it.
#
# TURN_EXTERNAL_IP  – the public IP address of the server running Docker.
# TURN_REALM        – any domain / hostname (does not need DNS; used for auth).
# TURN_USERNAME     – TURN credential username.
# TURN_PASSWORD     – TURN credential password (change before going to prod!).
# TURN_MIN_PORT     – first UDP relay port (must be open in your firewall).
# TURN_MAX_PORT     – last  UDP relay port (must be open in your firewall).
TURN_EXTERNAL_IP=localhost
TURN_REALM=turn.example.com
TURN_USERNAME=turnuser
TURN_PASSWORD=your-turn-password
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Format: JSON array of RTCIceServer objects.
# The IP, username, and credential values here MUST match
# TURN_EXTERNAL_IP, TURN_USERNAME, and TURN_PASSWORD above.
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:localhost:3478"],"username":"turnuser","credential":"your-turn-password"},{"urls":["turns:localhost:5349"],"username":"turnuser","credential":"your-turn-password"}]

# Vite
VITE_API_URL=http://localhost:8030
# Direct agent_teams URL for SSE streaming (leave empty to fall back to Django proxy)
VITE_AGENT_TEAMS_URL=http://localhost:7777

# Cloudfly S3-compatible object storage (for APK uploads)
# Set CLOUDFLY_ENABLED=True to force APK files onto S3 (DB keeps only the URL).
# When enabled, CLOUDFLY_ACCESS_KEY and CLOUDFLY_SECRET_KEY are required.
CLOUDFLY_ENABLED=False
CLOUDFLY_ACCESS_KEY=
CLOUDFLY_SECRET_KEY=
CLOUDFLY_BUCKET=your-bucket
CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
# Optional: override the public base URL for stored objects
# CLOUDFLY_PUBLIC_BASE_URL=https://s3.cloudfly.vn/your-bucket

# Shared secret the device worker presents in the X-Worker-Token header on
# the app-installation callback. Generate with: openssl rand -hex 32
WORKER_CALLBACK_TOKEN=

# Agent Teams (separate pgvector database)
AGENT_DB_NAME=agentdb
AGENT_DB_USER=agentdb
AGENT_DB_PASSWORD=agentdb

# Agent Teams – LLM / search API keys
OPENAI_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Key AI RIÊNG THEO TỪNG CÔNG TY — chỉ cần khi một máy chủ phục vụ nhiều công ty và
# mỗi công ty tự trả tiền bằng key của mình (để sao kê tách được).
# Cú pháp: slug1:key1,slug2:key2   — slug chữ thường, không dấu, không cách.
# Slug phải khớp ô "Công ty" (ai_tenant) gán cho tài khoản trong Django admin
# (/admin/auth/user/). Tài khoản để trống ô đó dùng OPENAI_API_KEY / FAL_KEY mặc định.
# Để TRỐNG cả 2 dòng = mọi tài khoản dùng key mặc định (hành vi khi chỉ có 1 khách).
# Chi tiết: mobile-control/content/ai_tenant.py
AI_TENANT_OPENAI_KEYS=
AI_TENANT_FAL_KEYS=

# Agent Teams service URL (used by backend to call the planner agent)
AGENT_TEAMS_URL=http://agent_teams:7777
# Comma-separated allowed CORS origins for the agent_teams SSE service
AGENT_TEAMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://app.example.com,https://app.example.com

# Agent Teams – rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_DAILY=50
RATE_LIMIT_PRO_DAILY=500
RATE_LIMIT_ENTERPRISE_DAILY=5000
RATE_LIMIT_DEFAULT_DAILY=100

# TikTok crawl service host (IP or hostname, no protocol, no port)
API_CRAWL_HOST=localhost
GROQ_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
