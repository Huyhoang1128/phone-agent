KAFKA_BOOTSTRAP_SERVERS=<host>:9094
WORKER_ID=
KAFKA_DEVICE_EVENTS_TOPIC=device-events
KAFKA_COMMANDS_TOPIC=device-commands
KAFKA_TASK_EXECUTION_TOPIC=task_execution
KAFKA_TASK_STATUS_TOPIC=task_status
KAFKA_TASK_ERROR_TOPIC=task_errors
KAFKA_CONSUMER_GROUP=mobile-agent-worker
ADB_SCAN_INTERVAL=5

# Host backend dashboard dùng chung cho Facebook + TikTok (đổi domain chỉ cần sửa dòng này)
API_BASE_URL=http://<host>:8030
# Api-Key cho dashboard
FACEBOOK_API_KEY=
TIKTOK_API_KEY=

# LLM Provider API Keys (set whichever provider you use)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
